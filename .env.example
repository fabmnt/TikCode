# Frontend values. `npx convex dev` writes CONVEX_DEPLOYMENT and CONVEX_URL
# to .env.local. Do not commit real values.

CONVEX_DEPLOYMENT=
CONVEX_URL=

# Optional public HTTP actions URL. When unset, the app derives it from
# CONVEX_URL by replacing `.convex.cloud` with `.convex.site`.
# CONVEX_SITE_URL=

# Convex deployment secrets. Set these with `npx convex env set`, not in the
# Astro/Vercel frontend environment. Never commit real values.
#
# BETTER_AUTH_SECRET=   # openssl rand -base64 32
# SITE_URL=http://localhost:4321
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# ADMIN_EMAILS=admin@example.com
# TRUSTED_ORIGINS=https://your-app.vercel.app
