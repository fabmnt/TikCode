---
import CreateQuizzes from "../components/create/CreateQuizzes.tsx";
import { CreateQuizzesPlaceholder } from "../components/create/CreateQuizzesPlaceholder.tsx";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Create quizzes · Quizz Feed">
  <main class="mx-auto flex h-dvh w-full max-w-2xl flex-col overflow-hidden md:border-x md:border-border">
    <header class="flex flex-col gap-1 px-4 pt-6">
      <h1 class="text-lg font-medium">Create quizzes</h1>
      <p class="text-muted-foreground text-sm">
        Quizzes go live in the feed as soon as you publish them.
      </p>
    </header>
    <CreateQuizzes client:only="react">
      <div slot="fallback" class="flex min-h-0 flex-1 flex-col">
        <CreateQuizzesPlaceholder />
      </div>
    </CreateQuizzes>
  </main>
</Layout>
