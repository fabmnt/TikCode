---
import GroupsView from "../components/groups/GroupsView.tsx";
import { buttonVariants } from "../components/ui/button";
import { Skeleton } from "../components/ui/skeleton";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Quizz groups · Quizz Feed">
  <main class="mx-auto flex h-dvh w-full max-w-2xl flex-col overflow-hidden md:border-x md:border-border">
    <header class="flex items-start justify-between gap-4 px-4 pt-6">
      <div class="flex flex-col gap-1">
        <h1 class="text-lg font-medium">Quizz groups</h1>
        <p class="text-muted-foreground text-sm">
          Groups keep their quizzes private. Share the join link to invite
          players.
        </p>
      </div>
      <a href="/groups/new" class={buttonVariants({ size: "lg" })}>
        New group
      </a>
    </header>
    <GroupsView client:only="react">
      <div slot="fallback" class="flex min-h-0 flex-1 flex-col gap-3 px-4 py-6">
        <Skeleton class="h-16 w-full" />
        <Skeleton class="h-16 w-full" />
      </div>
    </GroupsView>
  </main>
</Layout>
