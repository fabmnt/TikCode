---
import AdminPanel from "../components/admin/AdminPanel.tsx";
import Layout from "../layouts/Layout.astro";
import { Spinner } from "../components/ui/spinner";
---

<Layout title="Quizz Feed Admin">
  <main class="mx-auto min-h-dvh w-full max-w-2xl border-x border-border px-4 py-8">
    <AdminPanel client:only="react">
      <div slot="fallback" class="flex justify-center py-16">
        <Spinner />
      </div>
    </AdminPanel>
  </main>
</Layout>
